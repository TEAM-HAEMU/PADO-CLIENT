# ─── PADO 환경변수 ─────────────────────────────────────────────
# 백엔드 (API 명세: /api/v1)
API_BASE_URL=https://api.paado.app/api/v1
# true면 앱이 명세 응답을 흉내 내는 내장 목 서버를 사용 (로그인 없이 전 화면 확인용)
USE_MOCK=false

# Google Maps — iOS 키(번들 ID 제한) / Android 키(패키지+SHA-1 제한). iOS 키가 비면 Apple Maps(다크)로 대체
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# 소셜 로그인 (카카오 · Google) — 비어 있으면 해당 버튼을 누를 때 "설정 필요" 안내
KAKAO_NATIVE_APP_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Amplitude 분석 (프로젝트 API 키) — 비어 있으면 이벤트를 보내지 않음. 목 모드에서는 항상 끔
AMPLITUDE_API_KEY=
# 시연용: 목 모드에서도 전송(app_env=mock) / 세션 리플레이 샘플링(0~1, 기본 0.3)
AMPLITUDE_IN_MOCK=false
AMPLITUDE_REPLAY_SAMPLE_RATE=0.3

# Sentry 오류 진단 (DSN) — 비어 있으면 보내지 않음. 목 모드·개발 빌드(__DEV__)에서는 기본으로 끔
# 설정 › 이용 분석을 '끔'으로 둔 사람은 보내지 않음 (기본·상세 분석은 똑같이 보냄)
SENTRY_DSN=
# 검증용: 개발 빌드에서도 전송(environment=dev) / 목 모드에서도 전송(environment=mock)
SENTRY_IN_DEV=false
SENTRY_IN_MOCK=false
# 성능 추적(앱 시작·화면 전환) 샘플링 (0~1, 기본 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# 소스맵·dSYM 업로드용 인증 토큰은 여기 넣지 않는다 — README '오류 진단(Sentry)' 참고
